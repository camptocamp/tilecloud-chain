{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>camptocamp/gs-renovate-config-preset:base.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:group.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:ci.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:preset.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:pre-commit.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:python.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:docker.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:json-schema.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:shellcheck.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:stabilization-branches.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:own.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:security.json5#1.14.0',
  ],
  baseBranchPatterns: ['master', '1.17', '1.21', '1.22', '2.0'],
  customManagers: [
    /** Manage unpkg */
    {
      matchStrings: ['unpkg\\.com/(?<depName>[^@]+)@(?<currentValue>[^/]+)'],
      datasourceTemplate: 'npm',
      customType: 'regex',
      managerFilePatterns: ['/.*\\.html$/', '/.*\\.py$/'],
    },
    /** Manage jsdelivr */
    {
      matchStrings: ['cdn\\.jsdelivr\\.net/npm/(?<depName>[^@]+)@(?<currentValue>[^/]+)'],
      datasourceTemplate: 'npm',
      customType: 'regex',
      managerFilePatterns: ['/.*\\.html$/', '/.*\\.py$/'],
    },
  ],
  packageRules: [
    /** Docker images versioning */
    {
      matchDatasources: ['docker'],
      matchDepNames: ['camptocamp/mapserver'],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)$',
    },
    {
      matchDatasources: ['docker'],
      matchDepNames: ['ghcr.io/osgeo/gdal'],
      versioning: 'regex:^(?<compatibility>.*)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)?$',
    },
    /** Disable types-requests update on version <= 1.21 */
    {
      matchDepNames: ['types-requests'],
      matchBaseBranches: ['1.17', '1.18', '1.19', '1.20', '1.21'],
      enabled: false,
    },
    /** Disable requests update on version 1.17 */
    {
      matchDepNames: ['requests'],
      matchBaseBranches: ['1.17'],
      enabled: false,
    },
    /**
     * Disable pre-commit updates above 4.6.2 on version 1.21, the CI runs on ubuntu-22.04 with
     * Python 3.10 and pre-commit 4.7.0+ requires Python >= 3.11, which pip cannot install.
     */
    {
      matchDepNames: ['pre-commit'],
      matchBaseBranches: ['1.21'],
      allowedVersions: '<4.7.0',
    },
    /**
     * Disable python-dateutil updates above 2.x, aiobotocore pins python-dateutil <3.0.0
     * and no aiobotocore release supports python-dateutil 3 yet, so poetry cannot lock.
     */
    {
      matchDepNames: ['python-dateutil'],
      allowedVersions: '<3.0.0',
    },
    /** Ungroup Gdal */
    {
      matchDepNames: ['ghcr.io/osgeo/gdal'],
      groupName: 'Gdal',
    },
    /** Python should be x.y */
    {
      matchDepNames: ['python'],
      matchFileNames: ['.python-version$'],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)$',
    },
    /** Don't upgrade poetry-plugin-tweak-dependencies-version on branch 1.17 */
    {
      matchDepNames: ['poetry-plugin-tweak-dependencies-version'],
      matchBaseBranches: ['1.17'],
      enabled: false,
    },
    /**
     * Disable pillow update on stabilization branches whose declared Python version is lower than 3.11.
     * The releases fixing the CVEs require Python >= 3.11 while those branches still allow Python 3.10.
     */
    {
      matchDepNames: ['pillow'],
      matchBaseBranches: ['1.17', '1.21', '1.22'],
      enabled: false,
    },
  ],
}
